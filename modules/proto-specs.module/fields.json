    "default": [
      { "etiqueta": "Recámaras",        "value": "2",     "icon": { "src": "../../images/icon-recamaras.svg",      "alt": "Recámaras"        } },
      { "etiqueta": "Baños",            "value": "1",     "icon": { "src": "../../images/icon-banos.svg",           "alt": "Baños"            } },
      { "etiqueta": "Estacionamientos", "value": "1",     "icon": { "src": "../../images/icon-estacionamiento.svg", "alt": "Estacionamientos" } },
